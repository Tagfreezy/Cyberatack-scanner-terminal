# Copy to .env and fill in. .env is gitignored.
# Your Worker URL (printed by `npm run deploy`)
CYBERWATCH_API_URL=https://cyberwatch.<your-subdomain>.workers.dev
# The API_TOKEN secret you set on the Worker
CYBERWATCH_API_TOKEN=replace-me
# Poll interval in seconds (15-300; new data only arrives every 5 min, so 30-60 is plenty)
CYBERWATCH_POLL_SECONDS=45
CYBERWATCH_TIMEZONE=Europe/Zurich
