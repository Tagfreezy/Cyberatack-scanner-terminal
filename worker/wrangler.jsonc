{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberwatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // ONE cron trigger only. The free plan allows 5 cron triggers per *account*, so we
  // keep the rest free and decide which jobs run inside the handler (src/scheduler.ts).
  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyberwatch",
      // Filled in after `npx wrangler d1 create cyberwatch` (see README).
      "database_id": "ba5617a1-09be-4b06-9c27-4e6b9b5c0577",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI (classification + embeddings). Always runs remotely, even in `wrangler dev`.
  "ai": { "binding": "AI" },

  // Incident embeddings for dedupe (1024 dims, cosine). Created with:
  //   wrangler vectorize create cyberwatch-incidents --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index cyberwatch-incidents --propertyName=first_seen --type=number
  // No local emulation exists, so `wrangler dev` uses the real index ("remote": true).
  "vectorize": [{ "binding": "VECTORS", "index_name": "cyberwatch-incidents", "remote": true }],

  // Non-secret settings. Secrets go in `.dev.vars` (local) / `wrangler secret put` (prod).
  "vars": {
    // Models picked by an eval on real headlines (see worker/README.md, "AI model choice").
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "EMBED_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
    // Same-story duplicates scored ≥0.755, different stories ≤0.632 in the eval.
    "SIM_THRESHOLD": "0.70",
    // 2 per 5-min tick = ~576/day capacity vs ~140/day needed. Measured: each item adds only
    // ~2 ms CPU; most of a run's CPU is fixed overhead (cold start, D1/JSON handling).
    "AI_ITEMS_PER_RUN": "2",
    "ALERT_THRESHOLD": "4",
    "TIMEZONE": "Europe/Zurich",
    "USER_AGENT": "cyberwatch/1.0",
    "MAX_TELEGRAM_SENDS_PER_RUN": "4",
    "RSS_MAX_ITEMS": "20",
    // Optional Mastodon source (needs the MASTODON_ACCESS_TOKEN secret + /toggle mastodon)
    "MASTODON_INSTANCE": "infosec.exchange"
  },

  "observability": { "enabled": true }
}
